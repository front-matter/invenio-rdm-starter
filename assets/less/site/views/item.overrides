/***********************************************
    Invenio App RDM Starter Item Overrides
***********************************************/

article > section#record-info {
  margin-bottom: 0.5rem;
}
article > .ui.divider.hidden {
  display: none;
}

/* The first row of a record list item: date, resource type and DOI. Closer
   to the title below it than InvenioRDM's .75em. */
.ui.items > .item .extra.labels-actions {
  margin-bottom: 0.25em;
}
