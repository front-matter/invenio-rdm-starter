/***********************************************
         Invenio RDM Starter Site Overrides
***********************************************/

html.cover-page {
  background-color: @grey;
}

.creatibutor-link {
  color: @mutedTextColor;
  margin: 0 0.25rem 0 0;

  &:hover {
    text-decoration: none;

    span {
      color: @mutedTextColor;
      text-decoration: underline;
    }

    sup {
      color: @mutedTextColor;
    }
  }

  sup {
    color: @mutedTextColor;
    padding-left: .1rem;
  }
}

/* The funding section of the record page. Each funder is two headings, its
   name and its award, and InvenioRDM puts 1rem above every heading of a
   details list after the first, which spreads a funder over two loose
   lines. */
dl.details-list.funding-list dt.ui.tiny.header:not(:first-child) {
  margin-top: 0.4rem;
}

/* invenio-pidbox's menubar search: a red border while the field (or its
   select) has focus, as the Starter's form inputs have
   (@focusedFormBorderColor), and a red search button. "form" outranks
   pidbox's own rules, which come later in the page. */
form.pidbox-search:focus-within {
  border-color: @focusedFormBorderColor;
}

form.pidbox-search .ui.icon.button {
  background-color: @red;
  color: @white;

  &:hover,
  &:focus {
    background-color: @darkRed;
    color: @white;
  }
}

/* The Starter's mark: a ribbon across the menubar's top-left corner, as a
   staging site marks its own; the logo is InvenioRDM's. The menubar starts
   at the page's top-left corner, so the ribbon's ends run off the page and
   nothing has to clip it (which would clip the user menu's dropdown too).
   The menubar's left margin keeps it clear of the logo, except on a phone,
   where it may touch the logo's first letter. pointer-events: what is under
   the ribbon stays clickable. */
.outer-navbar {
  position: relative;

  &::before {
    content: "STARTER";
    position: absolute;
    top: 18px;
    left: -34px;
    z-index: 10;
    width: 120px;
    padding: 3px 0;
    transform: rotate(-45deg);
    background-color: @brown; // amber
    // Black: about 9.5:1 on the amber, where white would be about 2.2:1.
    color: #000000;
    font-weight: 900;
    font-size: 10px;
    letter-spacing: 1px;
    line-height: 1.2;
    text-align: center;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
    pointer-events: none;
  }
}

/* The About box above the front page's metrics (the page /about): text on
   the band itself, without a box of its own, left-aligned and larger, in
   the dark slate the band's light ground needs (white would be about 1.4:1
   on it), its links in the page's link colour (the header's are white). */
.outer-navbar .starter-frontpage-about .starter-frontpage-about-text {
  background: transparent;
  border: none;
  box-shadow: none;
  padding: 0;
  color: @darkGrey;
  // The size of the sidebar boxes' headers (.ui.medium.header, 18px).
  font-size: 1.28571rem;
  line-height: 1.4;
  text-align: left;

  p {
    margin: 0;
  }

  a {
    color: @linkColor;

    &:hover {
      color: @linkHoverColor;
      text-decoration: underline;
    }
  }
}

/* The metrics follow the About text closely: the padding between them, the
   text's row's and the metrics', only where the text is there. */
.outer-navbar .ui.grid > .row.starter-frontpage-about {
  padding-bottom: 0;

  & + #frontpage-metrics {
    padding-top: 0;
  }
}

/* The Starter Packs on the front page take the header band's light slate
   (PIDBOX_FRONTPAGE_METRICS_BACKGROUND, the wrapper's background): the
   carousel's own sky-blue tint would turn it blue-grey. */
.starter-featured-communities .ui.container.carousel {
  background-color: transparent;
}

/* Without permission to submit to a community, no "New upload" button,
   rather than a greyed-out one with a question mark explaining it: in the
   carousel of featured communities, and on a community's page. A user who
   may submit sees the button as always. */
.ui.button.disabled[href^="/uploads/new"],
.ui.button.disabled[href^="/uploads/new"] + i.question.circle.icon,
.inline-block[data-tooltip]:has(+ .ui.button.disabled[href^="/uploads/new"]) {
  display: none !important;
}
